  BorderColor #90A4AE
}
|Payroll Staff|
start
:Submit payroll draft;

|Finance Manager|
:Review totals and exceptions;
if (Approve payroll?) then (No)
  :Reject with comments;
  |Payroll Staff|
  :Correct payroll draft;
else (Yes)
  :Approve payroll;
  |System|
  :Lock payroll period;
  :Generate payment instructions;
  |Bank / Payment Provider|
  :Process salary payments;
  :Return payment status;
  |System|
  :Update payment results;
  |Payroll Staff|
  :Review failed payments;
endif
stop
@enduml


