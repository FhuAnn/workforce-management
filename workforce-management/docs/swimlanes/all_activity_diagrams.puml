@startuml
title 1. Project and Task Time Tracking
skinparam shadowing false
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #546E7A
  ArrowColor #607D8B
  DiamondBackgroundColor #ECEFF1
  DiamondBorderColor #546E7A
}
skinparam partition {
  BackgroundColor #FAFAFA
  BorderColor #90A4AE
}
|Employee|
start
:Select project and task;
:Start timer;

|System|
:Create active time session;
:Track elapsed and idle time;

|Employee|
if (Switch task?) then (Yes)
  :Select another task;
  |System|
  :Stop current task segment;
  :Start new task segment;
endif
:Stop timer;

|System|
:Calculate tracked duration;
:Attach time to employee, project, and task;
:Update timesheet;

|Manager|
:View project and task time summary;
stop
@enduml


@startuml
title 2A. Payroll Processing - Prepare Payroll
skinparam shadowing false
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #546E7A
  ArrowColor #607D8B
  DiamondBackgroundColor #ECEFF1
  DiamondBorderColor #546E7A
}
skinparam partition {
  BackgroundColor #FAFAFA
  BorderColor #90A4AE
}
|Payroll Staff|
start
:Select payroll period;
:Start payroll calculation;

|System|
:Load employee contracts;
:Load approved timesheets;
:Load overtime, leave, allowances,
and deductions;
:Validate payroll inputs;

if (Validation errors?) then (Yes)
  :Generate error list;
  |Payroll Staff|
  :Correct payroll data;
  :Run validation again;
else (No)
  :Calculate gross earnings;
  :Calculate deductions and taxes;
  :Calculate net salary;
  :Create payroll draft;
endif

|Payroll Staff|
:Review payroll draft;
stop
@enduml


@startuml
title 2B. Payroll Processing - Approval and Payment
